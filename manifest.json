{
  "manifest_version": 3,
  "name": "Cosmic JEV Extension",
  "version": "0.1.0",
  "description": "Glows event cards green or red across Eventbrite, Meetup, Luma, and confs.tech based on what Jev thinks of attending, from your real birth chart.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.eventbrite.com/*"
      ],
      "js": [
        "sites/eventbrite.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.meetup.com/*"
      ],
      "js": [
        "sites/meetup.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lu.ma/*",
        "https://luma.com/*"
      ],
      "js": [
        "sites/luma.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://confs.tech/*"
      ],
      "js": [
        "sites/confstech.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.eventbrite.com/*",
    "https://www.meetup.com/*",
    "https://lu.ma/*",
    "https://luma.com/*",
    "https://confs.tech/*",
    "https://cosmic-oracle-worker.cosmic-oracle.workers.dev/*"
  ],
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/brownie-check-small.png",
        "icons/brownie-x-small.png",
        "icons/brownie-question-small.png"
      ],
      "matches": [
        "https://www.eventbrite.com/*",
        "https://www.meetup.com/*",
        "https://lu.ma/*",
        "https://luma.com/*",
        "https://confs.tech/*"
      ]
    }
  ]
}
